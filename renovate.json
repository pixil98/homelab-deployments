{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "enabledManagers": [
    "flux", 
    "kubernetes"
  ],
  "registryAliases": {
    "registry.lab.reisman.org/proxy.ghcr.io": "ghcr.io",
    "registry.lab.reisman.org/proxy.docker.io": "docker.io",
    "registry.lab.reisman.org/proxy.quay.io": "quay.io",
    "registry.lab.reisman.org/proxy.gcr.io": "gcr.io",
    "registry.lab.reisman.org/proxy.registry.k8s.io": "registry.k8s.io"
  },
  "flux": {
    "managerFilePatterns": ["/^.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^.+\\.ya?ml$/"]
  },
  "ignorePaths": [
    "flux/flux-system/",
    "flux/removed/"
  ],
  "packageRules": [
    {
      "description": "Plex tags end in a per-release commit hash, which docker versioning treats as an incompatible suffix",
      "matchPackageNames": ["docker.io/plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    }
  ]
}
